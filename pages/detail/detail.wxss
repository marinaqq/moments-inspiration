.detail-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.nickname {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a2e;
}

.date {
  font-size: 22rpx;
  color: #bbb;
}

.detail-images {
  margin-bottom: 20rpx;
}

.detail-image {
  width: 100%;
  border-radius: 12rpx;
  margin-bottom: 12rpx;
}

.detail-text {
  font-size: 30rpx;
  line-height: 1.8;
  color: #333;
  margin-bottom: 16rpx;
}

.detail-desc {
  font-size: 26rpx;
  color: #888;
  margin-bottom: 16rpx;
  line-height: 1.6;
}

.desc-label {
  color: #6c5ce7;
  font-weight: 500;
}

.detail-tags {
  margin-bottom: 16rpx;
}

.detail-summary {
  padding-top: 16rpx;
  border-top: 1rpx solid #f0f0f0;
  font-size: 26rpx;
  color: #888;
  line-height: 1.6;
}

.summary-label {
  color: #6c5ce7;
  font-weight: 500;
}

.action-btn {
  width: 100%;
  margin-bottom: 20rpx;
}

.caption-list {
  margin-top: 10rpx;
}

.caption-item {
  background: #f7f7fa;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  position: relative;
}

.caption-item:active {
  background: #f0edff;
}

.caption-text {
  font-size: 28rpx;
  line-height: 1.6;
  color: #333;
  display: block;
}

.copy-hint {
  font-size: 22rpx;
  color: #6c5ce7;
  margin-top: 10rpx;
  display: block;
}

.inspiration-box {
  margin-top: 10rpx;
}

.inspiration-section {
  margin-bottom: 20rpx;
  font-size: 26rpx;
  line-height: 1.8;
  color: #555;
}

.inspiration-label {
  color: #6c5ce7;
  font-weight: 500;
  display: block;
  margin-bottom: 8rpx;
}

.inspiration-item {
  margin-bottom: 6rpx;
}

.imitate-tip {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 16rpx;
}

.btn-delete {
  background: #fff;
  color: #e74c3c;
  border: 1rpx solid #e74c3c;
  border-radius: 16rpx;
  padding: 20rpx 0;
  font-size: 28rpx;
  margin-top: 20rpx;
}

.btn-delete::after {
  border: none;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid #f0f0f0;
  border-top-color: #6c5ce7;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin: 0 auto;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}
