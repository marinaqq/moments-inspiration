.stats-card {
  display: flex;
  align-items: center;
  justify-content: space-around;
  padding: 40rpx 28rpx;
}

.stat-item {
  text-align: center;
  flex: 1;
}

.stat-num {
  display: block;
  font-size: 56rpx;
  font-weight: 700;
  color: #6c5ce7;
}

.stat-label {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
}

.stat-divider {
  width: 1rpx;
  height: 80rpx;
  background: #f0f0f0;
}

.section-title {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.toggle-icon {
  font-size: 24rpx;
  color: #6c5ce7;
  font-weight: normal;
}

.advanced-tip {
  font-size: 22rpx;
  color: #bbb;
  margin: 12rpx 0 20rpx;
  line-height: 1.6;
}

.form-label {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 8rpx;
  margin-top: 16rpx;
}

.form-label:first-of-type {
  margin-top: 0;
}

.save-config-btn {
  margin-top: 24rpx;
}

.clear-config-btn {
  margin-top: 16rpx;
}

.action-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
  font-size: 28rpx;
  color: #333;
}

.action-row:last-child {
  border-bottom: none;
}

.action-row.danger {
  color: #e74c3c;
}

.arrow {
  font-size: 36rpx;
  color: #ccc;
}

.about-card {
  text-align: center;
}

.about-text {
  font-size: 24rpx;
  color: #999;
  line-height: 2;
}
